{
  "name": "blank-slate",
  "version": "2.0.4",
  "description": "Blank-Slate.app — a moodboard/deck canvas where every tool is a single remixable file",
  "main": "js/main.js",
  "author": "Forma Rosa Creative",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win zip"
  },
  "dependencies": {
    "sharp": "^0.33.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.blankslate",
    "productName": "Blank-Slate",
    "asar": false,
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "js/**/*",
      "html/**/*",
      "_tools/**/*",
      "_baseline/**/*",
      "package.json",
      "!js/publish-community.js",
      "!**/*.bat",
      "!_projects/**",
      "!_decks/**",
      "!cache/**",
      "!dist/**",
      "!*.md",
      "LICENSE.md"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "Blank-Slate-${version}-win.${ext}"
    }
  }
}
